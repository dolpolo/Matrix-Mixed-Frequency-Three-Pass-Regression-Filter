# Publish only the replication package; keep other project materials local.
/*
!/Matrix-MF-TPRF_Replication/
!/README.md
!/.gitignore

# Exclude datasets and generated results from the public repository.
/Matrix-MF-TPRF_Replication/data/
/Matrix-MF-TPRF_Replication/results/

# Exclude local R state and machine-specific files.
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
.Renviron
.httr-oauth
.DS_Store
Thumbs.db
